from turtle import Turtle, Screen

tim = Turtle()
screen = Screen()

tim.speed("normal")


def move_forwards():
    tim.forward(100)


def move_backwards():
    tim.backward(100)


def move_anticlockwise():
    tim.left(120)


def move_clockwise():
    tim.right(25)


def reset_turtle():
    tim.clear()
    tim.penup()
    tim.home()
    tim.pendown()


screen.listen()
screen.onkey(move_forwards, "w")
screen.onkey(move_backwards, "s")
screen.onkey(move_anticlockwise, "a")
screen.onkey(move_clockwise, "d")
screen.onkey(reset_turtle, "c")

screen.exitonclick()